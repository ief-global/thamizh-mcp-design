# OS / editor junk
.DS_Store
Thumbs.db
*~
.idea/
.vscode/

# Python artifacts (skill workspaces may generate these)
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Local scratch
*.tmp
.env

# --- Claude Code local/session artifacts ---
.claude/settings.local.json
.claude/worktrees/
.claude/plans/

# Eval run store (regenerable; may cache CC BY-SA text — same rule as the code repo)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Eval RUN OUTPUTS are regenerable per-run artifacts — track the human-readable .md reports only,
# not the raw jsonl/logs/summaries or the per-run result subdirs (control/test/calib/opus-run/...).
thamizh-eval/results/*.jsonl
thamizh-eval/results/*.log
thamizh-eval/results/*.txt
thamizh-eval/results/*/

# Source documents are reference material, not redistributables. Keep the folder structure and the
# READMEs in git; do NOT commit third-party textbooks (TVA PDFs/ePUBs) even to this private repo
# until redistribution terms are confirmed. Remove a pattern below if a document is cleared.
# FAIL-SAFE by extension, not by folder. The rule used to name sources/tva/ and
# sources/classical/ explicitly, so a NEW source folder arrived unprotected —
# sources/lexicon/ (a 1.25 GB Madras Lexicon ePub) was untracked-but-committable in this
# PUBLIC repo on 2026-08-08. A source document must be ignored by default and cleared
# deliberately, never the other way round.
sources/**/*.pdf
sources/**/*.epub
sources/**/*.mobi
sources/**/*.djvu
sources/**/*.zip
sources/**/*.tar
sources/**/*.tar.gz
sources/**/*.txt.gz
