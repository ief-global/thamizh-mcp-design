# OS / editor junk
.DS_Store
Thumbs.db
*~
.idea/
.vscode/

# Python artifacts (skill workspaces may generate these)
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Local scratch
*.tmp
.env

# --- Claude Code local/session artifacts ---
.claude/settings.local.json
.claude/worktrees/
.claude/plans/

# Eval run store (regenerable; may cache CC BY-SA text — same rule as the code repo)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Eval RUN OUTPUTS are regenerable per-run artifacts — track the human-readable .md reports only,
# not the raw jsonl/logs/summaries or the per-run result subdirs (control/test/calib/opus-run/...).
thamizh-eval/results/*.jsonl
thamizh-eval/results/*.log
thamizh-eval/results/*.txt
thamizh-eval/results/*/
